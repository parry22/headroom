# Copy to .env and fill in. .env is git-ignored. Never commit a filled file.

# ---- Inference node ----
HF_TOKEN=                                  # optional: the default model is ungated
MODEL=RedHatAI/Meta-Llama-3.1-8B-Instruct-FP8   # ungated FP8 weights of Llama 3.1 8B (same architecture as meta-llama/Llama-3.1-8B-Instruct)
VLLM_PORT=8000
LMCACHE_PORT=5555                          # lmcache server RPC port
LMCACHE_HTTP_PORT=8080                     # lmcache server /metrics port
LMCACHE_L1_GB=40                           # CPU DRAM tier, ~65% of host RAM (63 GB box)
LMCACHE_L2_PATH=/root/lmcache-l2           # NVMe tier directory
LMCACHE_L2_GB=100
GPU_USD_PER_HR=0.35                        # RTX 4090 on Vast.ai; placeholder until the bench sets c_a
HOST_RAM_NVME_USD_PER_HR=0                 # included in GPU_USD_PER_HR if bundled
GPU_HBM_GB=24                              # node HBM; c_b models H200 throughput as config B x (141 - weights) / (GPU_HBM_GB - weights)
MODEL_WEIGHTS_GB=9.1                       # FP8 Llama 3.1 8B weights
H200_HBM_GB=141

# ---- Gateway ----
GATEWAY_PORT=3000
GATEWAY_PUBLIC_URL=http://localhost:3000
VLLM_URL=http://localhost:8000
LMCACHE_METRICS_URL=http://localhost:8080/metrics
RECEIPT_SIGNING_KEY=                       # secp256k1 hex, signs EIP-712 receipts; public half goes in /discovery.json
LEDGER_PATH=./gateway/ledger.db

# ---- Pricing ----
OPERATOR_SHARE_K=0.30
MIN_MARGIN_M=0.10
BASELINE_STALE_SECONDS=3600

# ---- Hedera (Mode A) ----
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=                        # 0.0.x, receives payments
HEDERA_OPERATOR_KEY=                       # ECDSA private key hex
HEDERA_USDC_TOKEN_ID=0.0.429274
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
X402_FALLBACK_FACILITATOR_URL=https://x402.org/facilitator
HCS_TOPIC_ID=                              # created once by scripts/hcs-create-topic.ts
HCS_BASELINE_TOPIC_ID=                     # tsx scripts/hcs-create-topic.ts "headroom CRE price baseline"

# ---- Arc (Mode B) ----
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_OPERATOR_KEY=                          # private key hex, posts batches
ARC_ESCROW_ADDRESS=                        # written by signer/src/deploy-escrow.ts
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
BATCH_EVERY_N=20
BATCH_EVERY_SECONDS=300

# ---- Chainlink CRE ----
CRE_ETH_PRIVATE_KEY=                       # only for `cre workflow simulate --broadcast`

# ---- Demo buyer agent ----
AGENT_HEDERA_ID=
AGENT_HEDERA_KEY=
AGENT_BUDGET_USDC=1.00
AGENT_TURNS=20

# ---- Arc tab demo (settle-demo) ----
BUYER_ARC_KEY=                             # demo buyer EVM key with Arc testnet USDC (faucet.circle.com)
SESSION_KEY=                               # session key registered on the escrow; defaults to BUYER_ARC_KEY
ARC_ESCROW_DEPLOY_BLOCK=0                  # reconcile scans events from here
TAB_REQUESTS=20
DEPOSIT_USDC=2

# ---- Pricing bootstrap (until bench/results/latest.json exists) ----
BOOTSTRAP_TOKENS_PER_HR_B=20000000                 # bootstrap placeholder; replaced by bench/results/latest.json
BOOTSTRAP_TOKENS_PER_HR_C=40000000                 # bootstrap placeholder; replaced by bench/results/latest.json
MAX_MODEL_LEN=40960                        # bench sessions reach ~36.5K prompt tokens (4K prefix + 32K private)
MAX_OUTPUT_TOKENS=2048

# ---- Dashboard / depth check ----
TEAM_WALLETS=                              # comma-separated buyer ids owned by the team, excluded from V1/V2
DASHBOARD_URL=http://localhost:3100
NEXT_PUBLIC_REPO_URL=https://github.com/parry22/headroom
